# Copy this file to .env and fill in your own values. Never commit .env.

# Cartesia.ai (Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_TTS_MODEL_ID=sonic-english
CARTESIA_TTS_VOICE_ID=c2ac25f9-ecc4-4f56-9095-651354df60c0

# Hugging Face Speech-to-Text model
HF_STT_MODEL_NAME=openai/whisper-tiny

# Question generation service (RAG/NLP module)
API_BASE_URL=https://your-question-generation-service.example.com

# Answer evaluation service
EXTERNAL_EVALUATION_API_URL=https://your-evaluation-service.example.com/evaluate

# Server
PORT=5001
FLASK_DEBUG=false
